{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "apex-powersports-forge",
  "main": ".output/server/index.mjs",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".output/public",
    "binding": "ASSETS"
