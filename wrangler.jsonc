"SUPABASE_PUBLISHABLE_KEY":"sb_publishable_VfsyO4Dr-xsosewAhLxyMA_-VnEvjNH"
"SUPABASE_URL":"https://drkceyolgwokwljfawbo.supabase.co"
"VITE_SUPABASE_PROJECT_ID":"drkceyolgwokwljfawbo"
"VITE_SUPABASE_PUBLISHABLE_KEY":"sb_publishable_VfsyO4Dr-xsosewAhLxyMA_-VnEvjNH"
"VITE_SUPABASE_URL":"https://drkceyolgwokwljfawbo.supabase.co"
  }
}
